# Server
PORT=3333
PUBLIC_BASE_URL=http://localhost:3333

# Transcription backend: faster-whisper is local; OpenAI is only used for summaries by default.
ASR_BACKEND=faster-whisper

# OpenAI transcription and optional summary
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_SUMMARY_MODEL=gpt-4o-mini
ENABLE_SUMMARY=false
DELETE_VIDEO_AFTER_TRANSCRIBE=true
MAX_CONCURRENT_JOBS=2
HISTORY_ANALYSIS_MAX_ITEMS=10
HISTORY_ANALYSIS_MAX_CHARS=6000

# Video link resolver: local-tools, ai-douyin, tikhub, or direct
# local-tools calls local open-source downloaders configured below.
VIDEO_INFO_PROVIDER=local-tools
AI_DOUYIN_API_BASE=https://top9.cc
AI_DOUYIN_API_KEY=
TIKHUB_TOKEN=

# Local open-source downloader paths.
# Clone them anywhere, install their Python dependencies, then point to each repo.
DOUYIN_DOWNLOADER_DIR=
DOUYIN_PYTHON=python3
DOUYIN_PROXY=
DOUYIN_INSECURE_TLS=0
XHS_DOWNLOADER_DIR=
XHS_PYTHON=python3
XHS_COOKIE=

# Local faster-whisper fallback
FW_PYTHON=python3
FW_MODEL_SIZE=small
FW_DEVICE=auto
FW_COMPUTE_TYPE=
HF_ENDPOINT=https://hf-mirror.com

# Volcengine ASR (optional)
VOLCENGINE_API_KEY=
VOLCENGINE_RESOURCE_ID=volc.seedasr.auc
VOLCENGINE_ASR_BASE=https://openspeech.bytedance.com/api/v3/auc/bigmodel
VOLCENGINE_ENABLE_PUNC=true
